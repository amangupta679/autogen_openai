# AutoGen AI Code Correction Agent - Environment Configuration
# =============================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains secrets!

# =====================
# 🔐 AUTHENTICATION
# =====================

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# GitLab Access Token
GITLAB_TOKEN=your-gitlab-token-here

# SonarQube Configuration
SONAR_TOKEN=your-sonarqube-token-here
SONAR_HOST_URL=http://localhost:9000

# =====================
# 🏗️ PROJECT SETTINGS
# =====================

# SonarQube Project
CI_PROJECT_KEY=your-project-key
SONAR_PROJECT_KEY=your-project-key

# Git Repository Configuration
GIT_REPO_URL=https://gitlab.company.com/your/repo.git
GIT_REPO_DIR=./repo
GIT_FILE_PATH=your-file.esql
GIT_OUTPUT_FILE=your-file_ai_autofix.esql

# Git executable path (adjust for your system)
# Linux/Mac: /usr/bin/git
# Windows: C:\\Program Files\\Git\\cmd\\git.exe
GIT_PYTHON_GIT_EXECUTABLE=/usr/bin/git

# =====================
# 🐳 CONTAINER SETTINGS
# =====================

# User/Group IDs for volume mounting (Linux/Mac only)
UID=1000
GID=1000

# Container resource limits
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_LIMIT=2.0

# Logging configuration
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# =====================
# 🔧 APPLICATION CONFIG
# =====================

# Application mode
ENVIRONMENT=production
CONTAINER_MODE=production

# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Directories (container paths)
DOWNLOADS_DIR=/app/downloads
LOGS_DIR=/app/logs
REPO_DIR=/app/repo

# =====================
# 🌐 NETWORK & PORTS
# =====================

# Agent web interface port (if enabled)
AGENT_PORT=8080

# SonarQube port (for local development)
SONAR_PORT=9000

# =====================
# 📊 REPORTING CONFIG
# =====================

# Report generation settings
GENERATE_PDF_REPORTS=true
GENERATE_CHARTS=true
CHART_RESOLUTION=300

# Email notifications (optional - for future enhancement)
# SMTP_SERVER=smtp.company.com
# SMTP_PORT=587
# SMTP_USERNAME=ai-agent@company.com
# SMTP_PASSWORD=your-smtp-password
# NOTIFICATION_RECIPIENTS=team@company.com

# =====================
# 🔒 SECURITY SETTINGS
# =====================

# IP protection settings
IP_PROTECTION_ENABLED=true
LICENSE_CHECK_ENABLED=true
USAGE_TRACKING_ENABLED=true

# Rate limiting (requests per minute)
API_RATE_LIMIT=60

# Session timeout (minutes)
SESSION_TIMEOUT=30

# =====================
# 📈 MONITORING & HEALTH
# =====================

# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# =====================
# 🏢 COMPANY BRANDING
# =====================

# Customize for your organization
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=licensing@company.com
LICENSE_CONTACT=licensing@company.com

# Agent metadata
AGENT_VERSION=1.0.0
AGENT_BUILD_DATE=2024-01-01
AGENT_VENDOR=Your Company

# =====================
# 🚀 ADVANCED OPTIONS
# =====================

# Parallel processing
MAX_WORKERS=4
ENABLE_ASYNC_PROCESSING=true

# Cache settings
ENABLE_CACHING=true
CACHE_TTL=3600

# Debug mode (NEVER enable in production!)
DEBUG_MODE=false
VERBOSE_LOGGING=false

# =====================
# 💾 BACKUP & STORAGE
# =====================

# Backup configuration
ENABLE_BACKUPS=true
BACKUP_RETENTION_DAYS=90
BACKUP_LOCATION=/app/backups

# Storage provider (local/s3/azure/gcp)
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
